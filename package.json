    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typebox": "1.3.7",
    "typescript": "5.7.2"
  }
}
