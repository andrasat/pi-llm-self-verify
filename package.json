{
  "name": "pi-llm-self-verify",
  "version": "0.1.0-rc.3",
  "description": "Best-of-N self-verification for pi coding-agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "self-verify",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": "git+https://github.com/andrasat/pi-llm-self-verify.git",
  "bugs": "https://github.com/andrasat/pi-llm-self-verify/issues",
  "files": [
    "extensions",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
